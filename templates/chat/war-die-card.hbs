<div class="fist-card wardie {{#if outcome}}outcome-{{outcome}}{{/if}}">
  <header class="card-bar">
    <span class="card-kicker">{{localize "FIST.WarDie.Label"}}</span>
    <span class="card-label">{{label}}</span>
  </header>
  <div class="card-roll">
    {{> "systems/fist/templates/parts/dice.hbs"}}
    <div class="card-mods"><span>{{previous}} + {{added}}</span></div>
    <div class="card-total">{{total}}</div>
  </div>
  {{#if bust}}<div class="card-alert">{{localize "FIST.WarDie.Bust"}}</div>{{/if}}
  {{#if outcome}}<div class="card-outcome"><strong>{{outcomeLabel}}</strong><span>{{outcomeText}}</span></div>{{/if}}
  <footer class="card-actions">
    {{#if canDamage}}<button type="button" data-fist-action="damage" data-item-uuid="{{itemUuid}}"><i class="fa-solid fa-burst"></i> {{localize "FIST.Damage.Roll"}}</button>{{/if}}
    {{#if isDamage}}
    <button type="button" data-fist-action="apply" data-total="{{total}}"><i class="fa-solid fa-shield-halved"></i> {{localize "FIST.Damage.Apply"}}</button>
    <button type="button" data-fist-action="applyRaw" data-total="{{total}}"><i class="fa-solid fa-bolt"></i> {{localize "FIST.Damage.ApplyRaw"}}</button>
    {{/if}}
    {{#if isPartial}}<button type="button" data-fist-action="partial" data-gm-only data-tooltip="{{localize "FIST.Partial.ButtonHint"}}"><i class="fa-solid fa-scale-unbalanced"></i> {{localize "FIST.Partial.Open"}}</button>{{/if}}
    <button type="button" data-fist-action="warDie"><i class="fa-solid fa-dice-d6"></i> {{localize "FIST.WarDie.Add"}}</button>
  </footer>
</div>
