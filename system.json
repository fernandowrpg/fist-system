  "background": "systems/fist/assets/fist-background.svg",
  "url": "https://github.com/fernandowrpg/fist-system",
  "manifest": "https://github.com/fernandowrpg/fist-system/releases/latest/download/system.json",
  "download": "https://github.com/fernandowrpg/fist-system/releases/download/v1.2.1/fist.zip",
  "bugs": "https://github.com/fernandowrpg/fist-system/issues",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
