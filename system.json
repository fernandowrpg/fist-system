{
  "id": "fist",
  "title": "FIST: Ultra Edition",
  "description": "Unofficial system for FIST: Ultra Edition (Freelance Infantry Strike Team), the paranormal mercenary RPG by CLAYMORE. Draggable traits, roles, gear and enemies that update the operative profile automatically, plus a step-by-step merc builder.",
  "version": "1.2.1",
  "authors": [
    {
      "name": "FIST system contributors"
    }
  ],
  "license": "LICENSE.txt",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "fist.mjs"
  ],
  "styles": [
    "styles/fist.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "merc": {
        "htmlFields": [
          "system.info",
          "system.notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "system.description"
        ]
      },
      "vehicle": {
        "htmlFields": [
          "system.description"
        ]
      }
    },
    "Item": {
      "trait": {
        "htmlFields": [
          "system.effect"
        ]
      },
      "role": {
        "htmlFields": [
          "system.answer"
        ]
      },
      "weapon": {
        "htmlFields": [
          "system.description"
        ]
      },
      "armor": {
        "htmlFields": [
          "system.description"
        ]
      },
      "gear": {
        "htmlFields": [
          "system.description"
        ]
      },
      "tag": {
        "htmlFields": [
          "system.description"
        ]
      },
      "ability": {
        "htmlFields": [
          "system.description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "traits",
      "label": "Traits Index",
      "path": "packs/traits",
      "type": "Item",
      "system": "fist",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
