    {
      "name": "FIST: Ultra Edition",
      "sorting": "m",
      "color": "#111111",
      "packs": [
        "rules",
        "traits",
        "roles",
        "weapons",
        "tags",
        "gear",
        "tables"
      ],
      "folders": [
        {
          "name": "Dossiers",
          "sorting": "m",
          "color": "#2a2a2a",
          "packs": [
            "mercs",
            "enemies",
            "vehicles"
          ]
        }
      ]
